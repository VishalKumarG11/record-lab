{
  "name": "record-lab-app",
  "productName": "record-lab-app",
  "version": "1.0.0",
  "description": "My Electron application description",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "npm run package && npm run make:windows",
    "make:windows": "set \"PATH=%SystemRoot%\\System32\\WindowsPowerShell\\v1.0;%PATH%\" && electron-builder --win",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": {
    "name": "Vishal Kumar",
    "email": "63749299+VishalKumarG11@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "autoprefixer": "^10.6.1",
    "babel-loader": "^10.1.1",
    "css-loader": "^6.11.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "com.recordlab.app",
    "productName": "Record-Lab",
    "directories": {
      "output": "out"
    },
    "files": [
      ".webpack/x64/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": ".webpack/x64/main/index.js"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/record-lab-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Record-Lab",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
